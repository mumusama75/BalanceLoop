# Copy to .env and fill in your own values. .env is git-ignored.
BL_DATABASE_URL=sqlite:///./balanceloop.db

# LLM provider: "cloud" (any OpenAI-compatible chat/completions API) or "mock" (offline, deterministic)
BL_LLM_PROVIDER=mock
# For "cloud": the server's base URL (https://host, https://host/v1 or the full .../v1/chat/completions all work),
# the model name as the server knows it, and the key. Examples:
#   DeepSeek:        BL_LLM_BASE_URL=https://api.deepseek.com        BL_LLM_MODEL=deepseek-chat
#   OpenAI:          BL_LLM_BASE_URL=https://api.openai.com          BL_LLM_MODEL=gpt-4o-mini
#   self-hosted vLLM/Ollama/LiteLLM given by a lecturer:  BL_LLM_BASE_URL=http://host:port   BL_LLM_MODEL=<name they give>
# Verify with:  uv run python backend/llm_check.py
BL_LLM_BASE_URL=https://api.deepseek.com
BL_LLM_MODEL=deepseek-chat
BL_LLM_API_KEY=sk-your-key-here
BL_LLM_TIMEOUT_SECONDS=60

# Review policy version the Safety Supervisor requires (fail-closed if the active policy differs)
BL_REQUIRED_POLICY_VERSION=1.0

BL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
